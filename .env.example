# Токен бота от @BotFather
BOT_TOKEN=1234567890:AAExampleTokenReplaceWithRealOne

# Облачный PostgreSQL (Neon, Supabase, Railway и т.д.)
# Поддерживаются форматы postgresql+asyncpg://..., postgresql://... и postgres://...
DATABASE_URL=postgresql+asyncpg://postgres:postgres@ep-example.eu-central-1.aws.neon.tech/pay_bot?sslmode=require

# Telegram ID суперадминистраторов платформы (через запятую или JSON-список)
ADMIN_IDS=123456789

# Базовый HTTPS URL вашего приложения на Vercel (без завершающего слэша)
WEBHOOK_URL=https://your-pay-bot.vercel.app

# Секретный токен для проверки заголовка X-Telegram-Bot-Api-Secret-Token и /api/set_webhook
# Допустимые символы Telegram API: A-Z, a-z, 0-9, _ и - (рекомендуется 32+ символа)
WEBHOOK_SECRET=replace_with_long_random_secret_token_32chars

# Секрет для авторизации Vercel Cron (заголовок Authorization: Bearer <CRON_SECRET>)
# Должен совпадать с переменной CRON_SECRET в настройках проекта Vercel
CRON_SECRET=replace_with_long_random_cron_secret_32chars
